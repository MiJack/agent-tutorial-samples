# Existing Pi configuration; use an absolute path if overriding.
# PI_CODING_AGENT_DIR=/absolute/path/to/.pi/agent
# Agent workspace; relative paths are resolved from the startup directory.
# PI_WEB_WORKSPACE=./demo-workspace
# Application-owned native session data.
# PI_WEB_DATA_DIR=.data
# Optional Skills-only discovery roots (OS-specific path delimiter).
# PI_WEB_SKILL_DIRS=/absolute/path/to/tutorial-skills
